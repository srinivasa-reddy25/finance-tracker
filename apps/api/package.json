{
  "name": "@tejadev/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express API app for TejaDev monorepo template",
  "scripts": {
    "dev": "dotenv -e ../../.env -- bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap",
    "start": "dotenv -e ../../.env -- bun src/index.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "dotenv -e ../../.env -- bun src/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run 'src/**/*.test.ts'",
    "test:int": "vitest run 'src/tests/integration/**/*.ts'",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tejadev/email": "workspace:*",
    "@tejadev/shared": "0.0.0",
    "cors": "^2.8.5",
    "db": "workspace:*",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-fileupload": "^1.5.2",
    "firebase-admin": "^13.6.0",
    "logging": "workspace:*",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "zod": "^3.23.8",
    "zod-error": "^1.5.0"
  },
  "devDependencies": {
    "@tejadev/eslint-config": "workspace:*",
    "@tejadev/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.1.3",
    "@vitest/ui": "^3.1.3",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.1",
    "vitest": "^3.1.3"
  }
}
