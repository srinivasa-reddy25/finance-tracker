{
  "name": "tejadev-template",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "postinstall": "bun run build:pkg",
    "predev": "bun run build:pkg",
    "start": "turbo run start",
    "dev": "turbo run dev --concurrency=20",
    "build": "turbo run build",
    "build:pkg": "turbo run build --filter='./packages/*'",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{json,js,mjs,cjs,jsx,ts,tsx,css,md}\"",
    "format:check": "prettier --check \"**/*.{json,js,mjs,cjs,jsx,ts,tsx,css,md}\"",
    "ci:check": "bun run format:check && bun run lint && bun run typecheck && bun run build"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/api",
    "apps/cron",
    "apps/web",
    "packages/*"
  ],
  "devDependencies": {
    "@tejadev/eslint-config": "workspace:*",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.4",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "(apps|packages)/**/*.{js,mjs,cjs,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "(apps|packages)/**/*.css": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.6",
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "sharp": "0.33.2"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "dependencies": {
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0"
  }
}
